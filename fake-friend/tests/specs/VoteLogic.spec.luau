local VoteLogic = requireShared("Logic/VoteLogic")

local ALIVE = { [1] = true, [2] = true, [3] = true, [4] = true }

describe("VoteLogic", function()
	it("eliminates the clear majority", function()
		local votes = VoteLogic.new()
		VoteLogic.cast(votes, 1, 3, ALIVE, false)
		VoteLogic.cast(votes, 2, 3, ALIVE, false)
		VoteLogic.cast(votes, 3, 1, ALIVE, false)
		local result = VoteLogic.tally(votes, ALIVE)
		expect(result.outcome).toBe("Eliminated")
		expect(result.eliminatedId).toBe(3)
	end)

	it("a tie sends nobody home", function()
		local votes = VoteLogic.new()
		VoteLogic.cast(votes, 1, 3, ALIVE, false)
		VoteLogic.cast(votes, 2, 4, ALIVE, false)
		local result = VoteLogic.tally(votes, ALIVE)
		expect(result.outcome).toBe("Tie")
		expect(result.eliminatedId).toBeNil()
	end)

	it("skip can win", function()
		local votes = VoteLogic.new()
		VoteLogic.cast(votes, 1, VoteLogic.SKIP, ALIVE, false)
		VoteLogic.cast(votes, 2, VoteLogic.SKIP, ALIVE, false)
		VoteLogic.cast(votes, 3, 4, ALIVE, false)
		expect(VoteLogic.tally(votes, ALIVE).outcome).toBe("Skipped")
	end)

	it("no votes means nobody leaves", function()
		expect(VoteLogic.tally(VoteLogic.new(), ALIVE).outcome).toBe("NoVotes")
	end)

	it("rejects double votes, dead voters, dead targets and self votes", function()
		local votes = VoteLogic.new()
		local alive = { [1] = true, [2] = true, [3] = false }
		expect(VoteLogic.cast(votes, 1, 2, alive, false)).toBe(true)
		local ok, err = VoteLogic.cast(votes, 1, 2, alive, false)
		expect(ok).toBe(false)
		expect(err).toBe("AlreadyVoted")
		ok, err = VoteLogic.cast(votes, 3, 1, alive, false)
		expect(err).toBe("NotAlive")
		ok, err = VoteLogic.cast(votes, 2, 3, alive, false)
		expect(err).toBe("InvalidTarget")
		ok, err = VoteLogic.cast(votes, 2, 2, alive, false)
		expect(err).toBe("SelfVote")
		expect(VoteLogic.cast(votes, 2, 2, alive, true)).toBe(true)
	end)

	it("ignores votes from players who left", function()
		local votes = VoteLogic.new()
		VoteLogic.cast(votes, 1, 3, ALIVE, false)
		VoteLogic.cast(votes, 2, 3, ALIVE, false)
		VoteLogic.cast(votes, 4, 1, ALIVE, false)
		local afterLeave = { [1] = true, [2] = false, [3] = true, [4] = true }
		expect(VoteLogic.tally(votes, afterLeave).outcome).toBe("Tie")
	end)

	it("knows when everyone has voted", function()
		local votes = VoteLogic.new()
		VoteLogic.cast(votes, 1, 2, ALIVE, false)
		expect(VoteLogic.allVoted(votes, { 1, 2 })).toBe(false)
		VoteLogic.cast(votes, 2, VoteLogic.SKIP, ALIVE, false)
		expect(VoteLogic.allVoted(votes, { 1, 2 })).toBe(true)
	end)
end)
